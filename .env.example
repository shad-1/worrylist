# OpenRouter
OPENROUTER_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Notion
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=
NOTION_THOUGHTS_DB_ID=
NOTION_TASKS_DB_ID=
NOTION_ALERTS_DB_ID=
NOTION_WEBHOOK_SECRET=
# Parent page under which the agent creates one digest child page per night
NOTION_DIGESTS_PAGE_ID=

# Google Calendar (read-only, digest only)
# Service-account JSON (single line). The service account's email must be
# granted read access to the calendar below.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=primary

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Worker
DEFAULT_WORKER_MODEL=google/gemini-3.1-flash-lite

# App
PORT=3000
